# ==============================================================================
# POSTGRESQL & POSTGIS
# ==============================================================================
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rides
POSTGRES_SSLMODE=disable

# Full connection URL
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/rides?sslmode=disable
POSTGRES_URL=postgres://postgres:postgres@127.0.0.1:5432/rides?sslmode=disable

# ==============================================================================
# REDIS (In-Memory Store & Cache)
# ==============================================================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Full Redis connection URL
REDIS_URL=redis://127.0.0.1:6379/0

# ==============================================================================
# APACHE KAFKA (External Listener)
# ==============================================================================
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_BROKERS=127.0.0.1:9092
KAFKA_TOPIC=telemetry.dhaka
KAFKA_GROUP_ID=telemetry-consumer-group
